[
  {
    "name": "chat_basic",
    "description": "基本对话请求 - 验证返回结构和字段",
    "request": {
      "method": "POST",
      "path": "/api/v1/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "你好",
        "session_id": "test-session",
        "user_id": "test-user"
      }
    },
    "expected": {
      "status": 200,
      "body_fields": {
        "reply": {
          "type": "str",
          "min_length": 1
        },
        "session_id": {
          "type": "str",
          "equals": "test-session"
        },
        "messages_count": {
          "type": "int",
          "min": 0
        }
      }
    }
  },
  {
    "name": "chat_default_session_id",
    "description": "未传 session_id 时使用默认值 'default'",
    "request": {
      "method": "POST",
      "path": "/api/v1/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "推荐课程"
      }
    },
    "expected": {
      "status": 200,
      "body_fields": {
        "reply": {
          "type": "str",
          "min_length": 1
        },
        "session_id": {
          "type": "str",
          "equals": "default"
        },
        "messages_count": {
          "type": "int",
          "min": 0
        }
      }
    }
  },
  {
    "name": "chat_empty_message",
    "description": "空消息应返回 422 验证错误",
    "request": {
      "method": "POST",
      "path": "/api/v1/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "",
        "session_id": "s1"
      }
    },
    "expected": {
      "status": 422,
      "body_fields": {
        "detail": {
          "type": "list",
          "min_length": 1
        }
      }
    }
  },
  {
    "name": "chat_long_message",
    "description": "超过 max_length 的消息应返回 422",
    "request": {
      "method": "POST",
      "path": "/api/v1/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "message": "",
        "session_id": "s1"
      }
    },
    "expected": {
      "status": 422,
      "body_fields": {
        "detail": {
          "type": "list",
          "min_length": 1
        }
      }
    }
  }
]