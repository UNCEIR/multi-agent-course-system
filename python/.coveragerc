[run]
source = .
branch = true
omit =
    tests/*
    .venv/*
    __pycache__/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod

show_missing = true
precision = 2
