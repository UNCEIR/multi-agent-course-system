LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=your-llm-base-url
LLM_MODEL=your-model-name
LLM_ENABLE_THINKING=true

EMBEDDING_PROVIDER=your-embedding-provider
EMBEDDING_BASE_URL=your-embedding-base-url
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=your-embedding-model-name
EMBEDDING_DIMENSION=xxxx
MILVUS_DIMENSION=xxxx
COURSE_MILVUS_COLLECTION=your-collection-name
HTTPX_VERIFY_SSL=false

# 轻量认证 token 签名密钥（生产必须设置强随机值，否则任何人可伪造登录 token）
# AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
# report 填表：true=LLM 主路（37 人约 12~15min）；false=确定性 Jinja2 直填（快 ~10x，推荐）
REPORT_LLM_FILL_ENABLED=true
