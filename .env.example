# =============================================================================
# LLM（ChatOpenAI 兼容端点）
# =============================================================================
# 放置位置（任选其一，应用会依次加载）：<仓库根>/.env 、 python/.env
# （在 python/ 目录下 uvicorn main:app 时也会读取仓库根 .env）
# docker compose -f docker-compose.python.yml **仅注入** ./python/.env；根目录 .env 不会自动进容器，请把密钥写入 python/.env 供 Compose 使用。
# pytest 主链路单测使用 Stub，不会请求此处；仅运行服务并调 API 时才会计费。

ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.deepseek.com
ECOM_LLM_MODEL=deepseek-v4-pro

# --- 灵积 DashScope（OpenAI 兼容模式，可在控制台看到调用与 token）---
# 将下面三行解除注释并填入真实值后启动应用，再调 POST /api/v1/recommend 验证。
# ECOM_LLM_API_KEY=<你的 DashScope API Key>
# ECOM_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ECOM_LLM_MODEL=qwen-plus

# =============================================================================
# 向量 Embedding（默认 local 不占 DashScope 额度）
# =============================================================================
# ECOM_EMBEDDING_PROVIDER=local
# 若需向量也走灵积，使用：
# ECOM_EMBEDDING_PROVIDER=dashscope_multimodal
# ECOM_EMBEDDING_API_KEY=<与灵积一致或单独申请>
# ECOM_EMBEDDING_MODEL=text-embedding-v4
# ECOM_EMBEDDING_BASE_URL=
# ECOM_EMBEDDING_DIMENSION=64
